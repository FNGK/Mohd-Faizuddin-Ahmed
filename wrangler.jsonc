{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seowithfaiz",
  "main": "worker.js",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "allowed_destination_addresses": ["md.faiz.ahmed62@gmail.com"],
      "allowed_sender_addresses": ["win@seowithfaiz.com"]
    }
  ],
  // CRM lead storage (see seo/crm-setup.md)
  "d1_databases": [
    { "binding": "CRM_DB", "database_name": "swf-crm", "database_id": "dd0b6773-a2a0-4e48-955b-77715c05fc05" }
  ],
  // The Meta Pixel ID is public (embedded in the browser Pixel on every page),
  // so it lives here as a plaintext var — guaranteed present on every deploy.
  // META_CAPI_TOKEN is a Secret (dashboard / wrangler secret put), NEVER here.
  "vars": { "META_PIXEL_ID": "1688219305569530" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Clean/extensionless URLs are canonical. "none" disables Cloudflare's own
    // html_handling redirects so worker.js owns all routing with explicit 301s.
    // (Cloudflare's built-in "auto-trailing-slash" would give clean URLs too,
    // but via 307/temporary redirects — weaker for SEO than the worker's
    // permanent 301 .html -> clean.)
    "html_handling": "none",
    // Static assets are served BEFORE the worker by default, so a request for a
    // real file like /services/web-design-development.html would bypass
    // worker.js entirely and never reach its .html -> clean 301. Run the worker
    // first so it intercepts every request; genuine static assets (css/js/img)
    // fall through to env.ASSETS.fetch() in the worker's tail branch.
    "run_worker_first": true,
    "exclude": [
      "**/.git/**",
      "**/.wrangler/**",
      "**/node_modules/**",
      "**/cms/**",
      "**/server/**",
      "**/automation/**",
      "**/client-acquisition-engine/**",
      "**/functions/**",
      "**/*.md",
      "**/formsubmit-test-out.html",
      "**/lh-local.json",
      "**/lighthouse-logo-restore.json",
      "**/Professional_Resume.html",
      "**/Professional_Resume.md",
      "**/worker.js",
      "**/wrangler.jsonc",
      "**/package-lock.json",
      "**/package.json"
    ]
  }
}
